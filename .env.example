# Your LeanScope secrets. Copy this file to `.env` (gitignored) and fill in the values.
#
# `.env` is the one place for them:
#   - The Angular app gets them at build time (npm start, npm run build).
#   - `npm run connect:claude` stores them in the LeanScope Agent Kit plugin in Claude Code, so
#     its MCP servers (modeling and running choreos) use the same token.
#
# Coding agents: never open, print or edit `.env`.

# Required. The `_guid` of the choreo (a LeanScope Scenario) the app runs. Not a secret, but it
# depends on your repository, so it lives here. Your coding agent tells you which one to use.
LEANSCOPE_CHOREO_SCENARIO_GUID=

# Required. Your personal team-repos access token: https://app.leanscope.ai/ → avatar (top-right).
# It names the repository your choreos live in.
LEANSCOPE_PERSONAL_TEAM_REPOS_ACCESS_TOKEN=

# At least one of OpenAI, Anthropic or Mistral: sessions run on your own key.
LEANSCOPE_OPENAI_API_KEY=
LEANSCOPE_ANTHROPIC_API_KEY=
LEANSCOPE_MISTRAL_API_KEY=

# Optional: voice (ElevenLabs) and 🎯 Decision Model steps (TypeSafe).
LEANSCOPE_ELEVENLABS_API_KEY=
LEANSCOPE_TYPESAFE_API_KEY=
